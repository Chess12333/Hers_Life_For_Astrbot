{
  "enabled": {
    "description": "启用输入状态回执",
    "type": "bool",
    "default": true
  },
  "refresh_seconds": {
    "description": "续期间隔秒数（QQ 端的输入状态会自己消失）",
    "type": "int",
    "default": 5,
    "slider": {
      "min": 2,
      "max": 15,
      "step": 1
    }
  },
  "max_seconds": {
    "description": "一条消息最多续多久（防止卡住后一直显示正在输入）",
    "type": "int",
    "default": 30,
    "slider": {
      "min": 10,
      "max": 180,
      "step": 10
    }
  },
  "platforms": {
    "description": "只在这些平台生效，逗号分隔",
    "type": "string",
    "default": "aiocqhttp"
  }
}